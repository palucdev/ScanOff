<?xml version="1.0" encoding="utf-8"?>
<!--
    Scanner overlay UI (inflated programmatically on top of fragment_scanner.xml).
    Controls:
      - Back/close button (top-left)
      - Page counter chip (top-center): shows "Page N" as pages accumulate
      - Bottom bar: camera-switch | shutter (large) | pdf-convert
      - Full-screen loading overlay with spinner (visibility="gone" at rest)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_ui_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <!-- Back / close button ─────────────────────────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/back_button"
        style="@style/Widget.ScanOff.CircularButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        android:contentDescription="@string/previous"
        app:icon="@drawable/ic_arrow_back_24px"
        app:iconTint="@color/white"
        app:backgroundTint="@color/gray_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Page counter chip ───────────────────────────────────────── -->
    <com.google.android.material.chip.Chip
        android:id="@+id/page_counter_chip"
        style="@style/Widget.Material3.Chip.Assist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:text="Page 1"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="@color/white"
        app:chipBackgroundColor="@color/gray_overlay"
        app:chipStrokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- Bottom control bar ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/black"
        android:minHeight="120dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Camera switch -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/camera_switch_button"
            style="@style/Widget.ScanOff.CircularButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/nav_scan"
            app:icon="@drawable/cameraswitch_24px"
            app:iconTint="@color/white"
            app:backgroundTint="@color/gray_overlay" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Shutter (large) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/camera_capture_button"
            style="@style/Widget.ScanOff.CircularButton.Large"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/action_scan_doc"
            app:icon="@drawable/filter_center_focus_24px"
            app:iconTint="@color/white"
            app:backgroundTint="@color/gray_overlay" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- PDF convert (enabled only after capture) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pdf_convert_button"
            style="@style/Widget.ScanOff.CircularButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/action_create_pdf"
            app:icon="@drawable/picture_as_pdf_24px"
            app:iconTint="@color/white"
            app:backgroundTint="@color/gray_overlay" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Full-screen loading overlay (visibility="gone" at rest) ─── -->
    <FrameLayout
        android:id="@+id/pdf_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/black_semi_transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/pdf_loading_spinner"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/white" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
