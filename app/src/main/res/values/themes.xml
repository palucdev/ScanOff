<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Minimal XML theme used only for the Activity window (AndroidManifest).
        All runtime theming is handled by Compose (ui/theme/Theme.kt).
        Parent changed from Theme.Material3.DayNight.NoActionBar to AppCompat
        because the Material 3 XML library is no longer a dependency.
    -->
    <style name="Base.Theme.ScanOff" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.ScanOff" parent="Base.Theme.ScanOff" />
</resources>
