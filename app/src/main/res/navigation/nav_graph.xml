<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <!-- ── Top-level destinations (IDs match bottom_nav_menu.xml items) ── -->

    <fragment
        android:id="@+id/nav_home"
        android:name="com.palucdev.scanoff.MenuFragment"
        android:label="@string/menu_fragment_label"
        tools:layout="@layout/fragment_menu">

        <action
            android:id="@+id/action_home_to_scanner"
            app:destination="@id/ScannerFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />

        <action
            android:id="@+id/action_home_to_document_detail"
            app:destination="@id/DocumentFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_scan"
        android:name="com.palucdev.scanoff.ScannerFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_scanner" />

    <fragment
        android:id="@+id/nav_pdfs"
        android:name="com.palucdev.scanoff.FolderListFragment"
        android:label="@string/nav_pdfs"
        tools:layout="@layout/fragment_pdfs">

        <action
            android:id="@+id/action_pdfs_to_document_detail"
            app:destination="@id/DocumentFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.palucdev.scanoff.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

    <!-- ── Non-top-level destinations ── -->

    <!--
        ScannerFragment as a pushed destination (launched from Home or any other screen).
        Uses a separate ID so the bottom nav does not highlight "Scan" when navigated here.
        nav_scan above keeps the bottom-nav tab entry; this one is the action target.
    -->
    <fragment
        android:id="@+id/ScannerFragment"
        android:name="com.palucdev.scanoff.ScannerFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_scanner">

        <action
            android:id="@+id/action_scanner_to_home"
            app:destination="@id/nav_home"
            app:popUpTo="@id/nav_home"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/DocumentFragment"
        android:name="com.palucdev.scanoff.DocumentFragment"
        android:label="@string/label_document_detail"
        tools:layout="@layout/fragment_document_detail">

        <argument
            android:name="documentPath"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

</navigation>
